<Window x:Class="DiskAnalyzer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:DiskAnalyzer.UI"
        mc:Ignorable="d"
        Title="{DynamicResource Loc.WindowTitle}"
        Icon="app.ico"
        Height="850" Width="1360"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Shared Context Menu for File Items -->
        <ContextMenu x:Key="SharedItemContextMenu">
            <MenuItem Header="{DynamicResource Loc.MenuOpen}" Command="{Binding OpenFileCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="▶" Foreground="{StaticResource AccentStartBrush}" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.MenuRevealInExplorer}" Command="{Binding OpenFolderCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="📁" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.MenuCopyFullPath}" Command="{Binding CopyPathCommand}" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <TextBlock Text="📋" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.MenuCopyAllDetails}" Command="{Binding CopyDetailsCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="📝" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Loc.MenuOpenCommandPromptHere}" Command="{Binding OpenTerminalCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="💻" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.MenuOpenPowerShellHere}" Command="{Binding OpenPowerShellCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="⚡" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Loc.MenuZoomIntoFolder}"
                      Command="{Binding ZoomTreemapCommand}"
                      CommandParameter="{Binding SelectedItem}">
                <MenuItem.Icon>
                    <TextBlock Text="🔍" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.MenuToggleHeatmap}"
                      Command="{Binding ToggleTreemapCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="🗺️" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Loc.MenuDeleteToRecycleBin}" Command="{Binding DeleteToRecycleBinCommand}" InputGestureText="Del">
                <MenuItem.Icon>
                    <TextBlock Text="🗑" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.MenuPermanentlyDelete}" Command="{Binding PermanentDeleteCommand}" InputGestureText="Shift+Del">
                <MenuItem.Icon>
                    <TextBlock Text="⚠️" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Loc.MenuProperties}" Command="{Binding ShowPropertiesCommand}" InputGestureText="Alt+Enter">
                <MenuItem.Icon>
                    <TextBlock Text="ℹ️" FontSize="12" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Top Toolbar / Ribbon -->
            <RowDefinition Height="Auto" />
            <!-- 1. Drive Usage Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Content Split View -->
            <RowDefinition Height="*" />
            <!-- 3. Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. TOP RIBBON / TOOLBAR -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Logo & Brand -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Drive Selector & Actions -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Search Input -->
                    <ColumnDefinition Width="*" />
                    <!-- Quick Tools & Admin Badge -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource AccentHGradientBrush}" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Disk" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" />
                            <TextBlock Text="Analyzer" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentStartBrush}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Loc.BrandSubtitle}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Drive Selection & Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Drive Dropdown -->
                    <ComboBox ItemsSource="{Binding Drives}"
                              SelectedItem="{Binding SelectedDrive}"
                              MinWidth="220"
                              Height="32"
                              Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Converter={StaticResource DriveDisplayTitleConverter}}" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Browse Folder Button -->
                    <Button Content="{DynamicResource Loc.BrowseButton}"
                            Command="{Binding BrowseFolderCommand}"
                            Height="32"
                            Margin="0,0,10,0"
                            ToolTip="{DynamicResource Loc.BrowseTooltip}" />

                    <!-- Scan Button -->
                    <Button Content="{DynamicResource Loc.ScanButton}"
                            Command="{Binding ScanCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="32"
                            MinWidth="85"
                            Margin="0,0,6,0"
                            ToolTip="{DynamicResource Loc.ScanTooltip}" />

                    <!-- Cancel Button -->
                    <Button Content="{DynamicResource Loc.CancelButton}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="32"
                            MinWidth="85"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="{DynamicResource Loc.CancelTooltip}" />
                </StackPanel>

                <!-- Real-Time Search Box -->
                <Grid Grid.Column="2" MaxWidth="450" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             Padding="28,5,28,5"
                             VerticalContentAlignment="Center" />
                    <!-- Search Icon -->
                    <TextBlock Text="🔍"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsHitTestVisible="False" />
                    <!-- Clear Search Button -->
                    <Button Content="✕"
                            Command="{Binding DataContext.ApplyFileFilter, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="OnClearSearchClick"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Visibility="{Binding SearchQuery, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="{DynamicResource Loc.ClearSearchTooltip}" />
                </Grid>

                <!-- Tools & Admin Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Admin Status Badge / Elevation -->
                    <Border CornerRadius="5"
                            Background="#1B3828"
                            BorderBrush="#00E676"
                            BorderThickness="1"
                            Padding="8,5"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc.AdminBadge}" FontWeight="SemiBold" FontSize="11" Foreground="#00E676" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Content="{DynamicResource Loc.RestartAdminButton}"
                            Command="{Binding RelaunchAsAdminCommand}"
                            Height="32"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                            ToolTip="{DynamicResource Loc.RestartAdminTooltip}" />

                    <!-- Runtime language selection -->
                    <Button Content="{DynamicResource Loc.LanguageMenu}"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OnLanguageMenuClick">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom"
                                         ItemsSource="{Binding PlacementTarget.DataContext.AvailableLanguages, RelativeSource={RelativeSource Self}}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="{x:Type MenuItem}"
                                           BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding DisplayName}" />
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <Setter Property="Command" Value="{Binding SelectCommand}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Show / Hide Heatmap Button -->
                    <ToggleButton Content="{Binding TreemapToggleText}"
                                  IsChecked="{Binding ShowTreemap}"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  ToolTip="{DynamicResource Loc.HeatmapTooltip}" />

                    <!-- Export CSV Button -->
                    <Button Content="{DynamicResource Loc.ExportCsvButton}"
                            Command="{Binding ExportCsvCommand}"
                            Height="32"
                            Margin="0,0,6,0"
                            ToolTip="{DynamicResource Loc.ExportCsvTooltip}" />

                    <!-- Copy Info Button -->
                    <Button Content="{DynamicResource Loc.CopyInfoButton}"
                            Command="{Binding CopyDetailsCommand}"
                            Height="32"
                            ToolTip="{DynamicResource Loc.CopyInfoTooltip}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. DRIVE USAGE BAR -->
        <ui:DriveUsageGauge Grid.Row="1"
                                  Drive="{Binding SelectedDrive}"
                                  CustomPath="{Binding CustomFolderPath}"
                                  Margin="12,8,12,6" />

        <!-- 2. MAIN CONTENT SPLIT VIEW -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.RowDefinitions>
                <!-- Upper Panel: Tree View / File View / Extension Types -->
                <RowDefinition Height="3*" MinHeight="150" />
                <!-- Splitter -->
                <RowDefinition Height="Auto" />
                <!-- Lower Panel: Breadcrumbs & Squarified Treemap -->
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="{x:Type RowDefinition}">
                            <Setter Property="Height" Value="2*" />
                            <Setter Property="MinHeight" Value="100" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTreemap}" Value="False">
                                    <Setter Property="Height" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <!-- UPPER PANEL: TABS -->
            <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}">
                <!-- TAB 1: TREE VIEW (Hierarchical Folder Structure) -->
                <TabItem Header="{DynamicResource Loc.TreeViewTab}">
                    <Grid Background="{StaticResource BgDarkBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- TreeView Header Bar -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="6,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="65" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{DynamicResource Loc.TreeNameHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,0,0,0" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Loc.TreeParentPercentHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{DynamicResource Loc.SizeHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{DynamicResource Loc.AllocatedHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="4" Text="{DynamicResource Loc.FilesHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="5" Text="{DynamicResource Loc.FoldersHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="6" Text="{DynamicResource Loc.TotalPercentHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="7" Text="{DynamicResource Loc.LastModifiedHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="8" Text="{DynamicResource Loc.AttributesHeader}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- TreeView Control -->
                        <ui:MultiSelectTreeView x:Name="MainTreeView"
                                                Grid.Row="1"
                                                ItemsSource="{Binding RootItems}"
                                                Style="{StaticResource MultiSelectTreeViewStyle}"
                                                ItemContainerStyle="{StaticResource {x:Type TreeViewItem}}"
                                                SelectionChanged="OnTreeViewSelectionChanged"
                                                MouseDoubleClick="OnTreeViewMouseDoubleClick"
                                                ContextMenu="{StaticResource SharedItemContextMenu}"
                                                BorderThickness="0"
                                                VirtualizingPanel.IsVirtualizing="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="220" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Name with File/Folder Icon -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Converter={StaticResource FileIconConverter}}"
                                                   Width="16" Height="16"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="Normal" />
                                        </StackPanel>

                                        <!-- Visual Percentage Bar -->
                                        <Grid Grid.Column="1" Margin="6,2" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding Percentage, Mode=OneWay}"
                                                         Height="12"
                                                         Minimum="0" Maximum="100"
                                                         Background="#161624"
                                                         BorderBrush="#2A2A3E"
                                                         BorderThickness="1" />
                                            <TextBlock Text="{Binding PercentageFormatted}"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeFormatted}"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <!-- Allocated Size -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding AllocatedSizeFormatted}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <!-- File Count -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding FileCountFormatted}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <!-- Folder Count -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding FolderCountFormatted}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <!-- % Total -->
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding PercentageFormatted}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <!-- Modified Date -->
                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11" />

                                        <!-- Attributes -->
                                        <TextBlock Grid.Column="8"
                                                   Text="{Binding Attributes}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </ui:MultiSelectTreeView>
                    </Grid>
                </TabItem>

                <!-- TAB 2: FILE VIEW (Flat Largest Files DataGrid) -->
                <TabItem Header="{DynamicResource Loc.FileViewTab}">
                    <DataGrid x:Name="FileDataGrid"
                              ItemsSource="{Binding FilteredFiles}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="OnFileDataGridSelectionChanged"
                              ContextMenu="{StaticResource SharedItemContextMenu}"
                              MouseDoubleClick="OnFileDataGridMouseDoubleClick">
                        <DataGrid.Columns>
                            <!-- Name with Icon -->
                            <DataGridTemplateColumn Header="{DynamicResource Loc.FileNameHeader}" Width="260" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Converter={StaticResource FileIconConverter}}"
                                                   Width="16" Height="16"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Folder Path -->
                            <DataGridTemplateColumn Header="{DynamicResource Loc.FolderHeader}" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="PathBlock"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Loaded="OnFolderPathBlockLoaded" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Extension -->
                            <DataGridTemplateColumn Header="{DynamicResource Loc.ExtensionShortHeader}" Width="70" SortMemberPath="Extension">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Extension, Converter={StaticResource ColorToBrushConverter}}"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Extension}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="{DynamicResource Loc.SizeHeader}"
                                                Binding="{Binding SizeFormatted}"
                                                SortMemberPath="Size"
                                                Width="100"
                                                ElementStyle="{StaticResource TextRightStyle}" />

                            <!-- Allocated Size -->
                            <DataGridTextColumn Header="{DynamicResource Loc.AllocatedHeader}"
                                                Binding="{Binding AllocatedSizeFormatted}"
                                                SortMemberPath="AllocatedSize"
                                                Width="100"
                                                ElementStyle="{StaticResource TextRightMutedStyle}" />

                            <!-- % Total -->
                            <DataGridTemplateColumn Header="{DynamicResource Loc.TotalPercentHeader}" Width="100" SortMemberPath="Percentage">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <ProgressBar Value="{Binding Percentage, Mode=OneWay}"
                                                         Height="12"
                                                         Minimum="0" Maximum="100"
                                                         Background="#161624"
                                                         BorderBrush="#2A2A3E"
                                                         BorderThickness="1" />
                                            <TextBlock Text="{Binding PercentageFormatted}"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Last Modified -->
                            <DataGridTextColumn Header="{DynamicResource Loc.DateModifiedHeader}"
                                                Binding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                SortMemberPath="LastModified"
                                                Width="140"
                                                ElementStyle="{StaticResource TextCenterMutedStyle}" />

                            <!-- Attributes -->
                            <DataGridTextColumn Header="{DynamicResource Loc.AttributesHeader}"
                                                Binding="{Binding Attributes}"
                                                Width="90"
                                                ElementStyle="{StaticResource TextCenterMutedStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 3: FILE TYPES (Extension Breakdown) -->
                <TabItem Header="{DynamicResource Loc.FileTypesTab}">
                    <DataGrid ItemsSource="{Binding ExtensionBreakdown}"
                              SelectedItem="{Binding SelectedExtension, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <!-- Color Swatch -->
                            <DataGridTemplateColumn Header="" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="14" Height="14"
                                                   RadiusX="3" RadiusY="3"
                                                   Fill="{Binding ColorHex, Converter={StaticResource ColorToBrushConverter}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Extension -->
                            <DataGridTemplateColumn Header="{DynamicResource Loc.ExtensionShortHeader}" Width="140" SortMemberPath="Extension">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Converter={StaticResource FileIconConverter}}"
                                                   Width="16" Height="16"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Total Size -->
                            <DataGridTextColumn Header="{DynamicResource Loc.TotalSizeHeader}"
                                                Binding="{Binding TotalSizeFormatted}"
                                                SortMemberPath="TotalSize"
                                                Width="120"
                                                ElementStyle="{StaticResource TextRightStyle}" />

                            <!-- Percentage of Total -->
                            <DataGridTemplateColumn Header="{DynamicResource Loc.PercentOfTotalHeader}" Width="160" SortMemberPath="Percentage">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <ProgressBar Value="{Binding Percentage, Mode=OneWay}"
                                                         Height="14"
                                                         Minimum="0" Maximum="100"
                                                         Foreground="{Binding ColorHex, Converter={StaticResource ColorToBrushConverter}}"
                                                         Background="#161624"
                                                         BorderBrush="#2A2A3E"
                                                         BorderThickness="1" />
                                            <TextBlock Text="{Binding PercentageFormatted}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- File Count -->
                            <DataGridTextColumn Header="{DynamicResource Loc.FileCountHeader}"
                                                Binding="{Binding FileCountFormatted}"
                                                SortMemberPath="FileCount"
                                                Width="110"
                                                ElementStyle="{StaticResource TextRightMutedStyle}" />

                            <!-- Allocated Size -->
                            <DataGridTextColumn Header="{DynamicResource Loc.AllocatedSizeHeader}"
                                                Binding="{Binding AllocatedSizeFormatted}"
                                                SortMemberPath="AllocatedSize"
                                                Width="120"
                                                ElementStyle="{StaticResource TextRightMutedStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- SPLITTER -->
            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeNS"
                          Visibility="{Binding ShowTreemap, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- LOWER PANEL: TREEMAP VISUALIZER -->
            <Grid Grid.Row="2"
                  Background="{StaticResource BgDarkBrush}"
                  Visibility="{Binding ShowTreemap, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <!-- Breadcrumbs & Actions -->
                    <RowDefinition Height="Auto" />
                    <!-- Treemap Canvas Control -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Breadcrumb Toolbar -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Nav Buttons & Breadcrumbs -->
                            <ColumnDefinition Width="*" />
                            <!-- Zoom Info & Controls -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Breadcrumb Trail -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Reset / Home Button -->
                            <Button Content="{DynamicResource Loc.RootButton}"
                                    Command="{Binding ResetTreemapZoomCommand}"
                                    Padding="6,3"
                                    Margin="0,0,4,0"
                                    FontSize="11"
                                    ToolTip="{DynamicResource Loc.RootTooltip}" />

                            <!-- Zoom Out Button -->
                            <Button Content="{DynamicResource Loc.UpButton}"
                                    Command="{Binding ZoomOutTreemapCommand}"
                                    Padding="6,3"
                                    Margin="0,0,8,0"
                                    FontSize="11"
                                    ToolTip="{DynamicResource Loc.UpTooltip}" />

                            <!-- Breadcrumb Items -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding BreadcrumbPaths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="❯"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10"
                                                           Margin="4,0,4,0"
                                                           VerticalAlignment="Center" />
                                                <Button Content="{Binding Name}"
                                                        Command="{Binding DataContext.ZoomTreemapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="5,2"
                                                        FontSize="11"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        Cursor="Hand" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Right Info -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,4,0">
                                <TextBlock Text="{Binding ActiveTreemapText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentStartBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Treemap FrameworkElement Control -->
                <ui:TreemapControl Grid.Row="1"
                                   RootItem="{Binding TreemapRoot}"
                                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                   ItemDoubleClickedCommand="{Binding ZoomTreemapCommand}"
                                   ContextMenu="{StaticResource SharedItemContextMenu}" />
            </Grid>
        </Grid>

        <!-- 3. STATUS BAR -->
        <Border Grid.Row="3"
                Background="#14141E"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Status & Metrics -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Progress Bar (while scanning) -->
                    <ColumnDefinition Width="200" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Selected Item Info -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentStartBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanMetricsText, StringFormat=' | {0}'}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ScanMetricsText, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>

                <!-- Scan Progress Bar -->
                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             Height="6"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Selected Item Details -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedItemText}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock Text="{Binding SelectedItemSizeText}"
                               FontSize="11"
                               Foreground="{StaticResource AccentStartBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
